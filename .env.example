# Copy these into your hosting provider's environment settings (for example Render > Environment).
# NEVER commit real values to Git.

# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: Google AI Studio API key for real AI-written drafts (free tier). Without it, drafts use a labelled template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public URL of this app (used in PayPal return links and payment links). Render sets RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=
SENDER_NAME=Accounts team
