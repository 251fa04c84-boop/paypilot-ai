# Copy these into your hosting provider's environment settings (for example Render > Environment).
# NEVER commit real values to Git.

# PostgreSQL judge-demo store (pre-provision the judge tenant before startup)
PG_STORAGE_MODE=judge_demo
DATABASE_URL=
JUDGE_DEMO_TENANT_ID=

# Optional private accounts. Use a separate least-privilege provisioning role;
# it needs INSERT on paypilot_tenants/paypilot_tenant_state/paypilot_users and
# SELECT on paypilot_users/paypilot_tenants. Do not use the public runtime URL.
ACCOUNT_PROVISIONING_DATABASE_URL=
# Generate with: openssl rand -base64 48 (must be at least 32 bytes)
SESSION_SECRET=

# PayPal Sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PayPal Dashboard > Apps & Credentials > Webhooks > Sandbox webhook ID
PAYPAL_WEBHOOK_ID=

# Optional: Google AI Studio API key for real AI-written drafts (free tier). Without it, drafts use a labelled template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Public URL of this app (used in PayPal return links and payment links). Render sets RENDER_EXTERNAL_URL automatically.
APP_BASE_URL=
SENDER_NAME=Accounts team

# Optional transactional password-reset email (Resend). Use a verified sender domain.
RESEND_API_KEY=
EMAIL_FROM=PayPilot Accounts <accounts@your-verified-domain.example>
